&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> stringRedisTemplate.&lt;span style="color:#1e66f5">opsForValue&lt;/span>().&lt;span style="color:#1e66f5">set&lt;/span>(key, JSONUtil.&lt;span style="color:#1e66f5">toJsonStr&lt;/span>(value), time, unit);
