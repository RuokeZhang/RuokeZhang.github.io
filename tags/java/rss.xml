&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#d20f39">long&lt;/span> nowSecond&lt;span style="color:#04a5e5;font-weight:bold">=&lt;/span>now.&lt;span style="color:#1e66f5">toEpochSecond&lt;/span>(ZoneOffset.&lt;span style="color:#1e66f5">UTC&lt;/span>);
