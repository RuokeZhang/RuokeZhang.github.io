&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> path&lt;span style="color:#04a5e5;font-weight:bold">.&lt;/span>append(&lt;span style="color:#40a02b">&amp;#39;(&amp;#39;&lt;/span>)
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> dfs(i&lt;span style="color:#04a5e5;font-weight:bold">+&lt;/span>&lt;span style="color:#fe640b">1&lt;/span>, &lt;span style="color:#04a5e5">open&lt;/span>&lt;span style="color:#04a5e5;font-weight:bold">+&lt;/span>&lt;span style="color:#fe640b">1&lt;/span>)
