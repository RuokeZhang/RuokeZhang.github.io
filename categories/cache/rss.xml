&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#9ca0b0;font-style:italic">//1. 从 Redis 查询商铺缓存&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> String shopJson&lt;span style="color:#04a5e5;font-weight:bold">=&lt;/span>stringRedisTemplate.&lt;span style="color:#1e66f5">opsForValue&lt;/span>().&lt;span style="color:#1e66f5">get&lt;/span>(key);
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#9ca0b0;font-style:italic">//2. 判断是否存在.null和&amp;#34;&amp;#34;都会被算作 blank&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#8839ef">if&lt;/span>(StrUtil.&lt;span style="color:#1e66f5">isNotBlank&lt;/span>(shopJson)){
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#9ca0b0;font-style:italic">//3. 存在。直接返回。&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> Shop shop&lt;span style="color:#04a5e5;font-weight:bold">=&lt;/span> JSONUtil.&lt;span style="color:#1e66f5">toBean&lt;/span>(shopJson, Shop.&lt;span style="color:#1e66f5">class&lt;/span>);
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#8839ef">return&lt;/span> Result.&lt;span style="color:#1e66f5">ok&lt;/span>(shop);
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> }
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#9ca0b0;font-style:italic">//判断命中的是否是空值&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#8839ef">if&lt;/span>(shopJson&lt;span style="color:#04a5e5;font-weight:bold">!=&lt;/span>&lt;span style="color:#fe640b">null&lt;/span>){
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#8839ef">return&lt;/span> Result.&lt;span style="color:#1e66f5">fail&lt;/span>(&lt;span style="color:#40a02b">&amp;#34;店铺信息不存在。&amp;#34;&lt;/span>);
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> }
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#9ca0b0;font-style:italic">//4. shopJson为null,说明缓存里不存在。根据 id茶数据库&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> Shop shop&lt;span style="color:#04a5e5;font-weight:bold">=&lt;/span>getById(id);
