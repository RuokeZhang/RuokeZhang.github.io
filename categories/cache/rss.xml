&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#9ca0b0;font-style:italic">//防止缓存穿透，将空值写入 redis&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> stringRedisTemplate.&lt;span style="color:#1e66f5">opsForValue&lt;/span>().&lt;span style="color:#1e66f5">set&lt;/span>(key,&lt;span style="color:#40a02b">&amp;#34;&amp;#34;&lt;/span>, CACHE_NULL_TTL, TimeUnit.&lt;span style="color:#1e66f5">MINUTES&lt;/span>);
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#8839ef">return&lt;/span> Result.&lt;span style="color:#1e66f5">fail&lt;/span>(&lt;span style="color:#40a02b">&amp;#34;店铺不存在&amp;#34;&lt;/span>);
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> }
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> stringRedisTemplate.&lt;span style="color:#1e66f5">opsForValue&lt;/span>().&lt;span style="color:#1e66f5">set&lt;/span>(CACHE_SHOP_KEY &lt;span style="color:#04a5e5;font-weight:bold">+&lt;/span> id, JSONUtil.&lt;span style="color:#1e66f5">toJsonStr&lt;/span>(shop), CACHE_SHOP_TTL, TimeUnit.&lt;span style="color:#1e66f5">MINUTES&lt;/span>);
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#8839ef">return&lt;/span> Result.&lt;span style="color:#1e66f5">ok&lt;/span>(shop);
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>}
