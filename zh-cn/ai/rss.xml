&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> ceil_mode&lt;span style="color:#04a5e5;font-weight:bold">=&lt;/span>&lt;span style="color:#fe640b">True&lt;/span> &lt;span style="color:#9ca0b0;font-style:italic"># 向上取整模式，保留不完整的边缘窗口&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#9ca0b0;font-style:italic"># stride默认等于kernel_size=3，也可以显式写stride=3，效果完全一致&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> )
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#8839ef">def&lt;/span> &lt;span style="color:#1e66f5">forward&lt;/span>(&lt;span style="color:#04a5e5">self&lt;/span>, x):
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#9ca0b0;font-style:italic"># 前向传播：**先卷积提取特征，再池化下采样**（CNN标准顺序）&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#9ca0b0;font-style:italic"># x: [b, 3, h, w]&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> x &lt;span style="color:#04a5e5;font-weight:bold">=&lt;/span> &lt;span style="color:#04a5e5">self&lt;/span>&lt;span style="color:#04a5e5;font-weight:bold">.&lt;/span>conv1(x) &lt;span style="color:#9ca0b0;font-style:italic"># 第一步：过卷积层，生成6通道特征图, [b, 6, h&amp;#39;, w&amp;#39;]&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#9ca0b0;font-style:italic"># h&amp;#39;=(h+2*p-k)/s+1&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> x &lt;span style="color:#04a5e5;font-weight:bold">=&lt;/span> &lt;span style="color:#04a5e5">self&lt;/span>&lt;span style="color:#04a5e5;font-weight:bold">.&lt;/span>maxpool1(x) &lt;span style="color:#9ca0b0;font-style:italic"># 第二步：过池化层，对特征图下采样&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#8839ef">return&lt;/span> x&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/td>&lt;/tr>&lt;/table>
