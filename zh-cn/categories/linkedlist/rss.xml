&lt;pre tabindex="0" style="color:#4c4f69;background-color:#eff1f5;-moz-tab-size:2;-o-tab-size:2;tab-size:2;">&lt;code class="language-python" data-lang="python">&lt;span style="display:flex;">&lt;span>&lt;span style="color:#8839ef">def&lt;/span> &lt;span style="color:#1e66f5">reverseBetween&lt;/span>(&lt;span style="color:#04a5e5">self&lt;/span>, head: Optional[ListNode], left: &lt;span style="color:#04a5e5">int&lt;/span>, right: &lt;span style="color:#04a5e5">int&lt;/span>) &lt;span style="color:#04a5e5;font-weight:bold">-&amp;gt;&lt;/span> Optional[ListNode]:
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#9ca0b0;font-style:italic">#因为答案的头节点可能会改，所以搞一个dummy&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> dummy&lt;span style="color:#04a5e5;font-weight:bold">=&lt;/span>ListNode(&lt;span style="color:#04a5e5">next&lt;/span>&lt;span style="color:#04a5e5;font-weight:bold">=&lt;/span>head)
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> pre&lt;span style="color:#04a5e5;font-weight:bold">=&lt;/span>dummy
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#9ca0b0;font-style:italic">#移动pre, cur到1和2&lt;/span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#8839ef">for&lt;/span> _ &lt;span style="color:#04a5e5;font-weight:bold">in&lt;/span> &lt;span style="color:#04a5e5">range&lt;/span>(left&lt;span style="color:#04a5e5;font-weight:bold">-&lt;/span>&lt;span style="color:#fe640b">1&lt;/span>):
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> pre&lt;span style="color:#04a5e5;font-weight:bold">=&lt;/span>pre&lt;span style="color:#04a5e5;font-weight:bold">.&lt;/span>next
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> cur&lt;span style="color:#04a5e5;font-weight:bold">=&lt;/span>pre&lt;span style="color:#04a5e5;font-weight:bold">.&lt;/span>next
