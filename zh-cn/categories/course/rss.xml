gin-right:0.4em;padding:0 0.4em 0 0.4em;color:#8c8fa1&#34;&gt;8&#xA;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&#xA;&lt;td style=&#34;vertical-align:top;padding:0;margin:0;border:0;;width:100%&#34;&gt;&#xA;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#4c4f69;background-color:#eff1f5;-moz-tab-size:2;-o-tab-size:2;tab-size:2;&#34;&gt;&lt;code class=&#34;language-java&#34; data-lang=&#34;java&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;channel &lt;span style=&#34;color:#04a5e5;font-weight:bold&#34;&gt;=&lt;/span&gt; grpc.&lt;span style=&#34;color:#1e66f5&#34;&gt;insecure_channel&lt;/span&gt;(&lt;span style=&#34;color:#40a02b&#34;&gt;&amp;#34;服务端IP:端口&amp;#34;&lt;/span&gt;)&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;&lt;span style=&#34;color:#d20f39&#34;&gt;#&lt;/span&gt; 客户端Stub&lt;span style=&#34;color:#d20f39&#34;&gt;（&lt;/span&gt;服务端函数的&lt;span style=&#34;color:#d20f39&#34;&gt;“&lt;/span&gt;本地替身&lt;span style=&#34;color:#d20f39&#34;&gt;”）&lt;/span&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;stub &lt;span style=&#34;color:#04a5e5;font-weight:bold&#34;&gt;=&lt;/span&gt; CalculatorStub(channel)&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;&lt;span style=&#34;color:#d20f39&#34;&gt;#&lt;/span&gt; 调用Stub的Add方法&lt;span style=&#34;color:#d20f39&#34;&gt;（&lt;/span&gt;感觉和调用本地函数一样&lt;span style=&#34;color:#d20f39&#34;&gt;）&lt;/span&gt;&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;request &lt;span style=&#34;color:#04a5e5;font-weight:bold&#34;&gt;=&lt;/span&gt; AddRequest(num1&lt;span style=&#34;color:#04a5e5;font-weight:bold&#34;&gt;=&lt;/span&gt;2, num2&lt;span style=&#34;color:#04a5e5;font-weight:bold&#34;&gt;=&lt;/span&gt;3)&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;response &lt;span style=&#34;color:#04a5e5;font-weight:bold&#34;&gt;=&lt;/span&gt; stub.&lt;span style=&#34;color:#1e66f5&#34;&gt;Add&lt;/span&gt;(request)&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&#xA;&lt;/div&gt;&#xA;&lt;/div&gt;&#xD;&#xA;&#xD;&#xA;&lt;/li&gt;&#xA;&lt;li&gt;server side实现add的具体逻辑&lt;/li&gt;&#xA;&lt;/ol&gt;&#xA;&lt;h3 id=&#34;semantics&#34;&gt;Semantics&#xA;&lt;a class=&#34;header-anchor&#34; href=&#34;#semantics&#34;&gt;&lt;/a&gt;&#xA;&lt;/h3&gt;&lt;p&gt;At most once&lt;/p&gt;</description>
