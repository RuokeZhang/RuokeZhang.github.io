&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>&lt;span style="color:#8839ef">class&lt;/span> &lt;span style="color:#df8e1d">CNN&lt;/span>(nn&lt;span style="color:#04a5e5;font-weight:bold">.&lt;/span>Module):
