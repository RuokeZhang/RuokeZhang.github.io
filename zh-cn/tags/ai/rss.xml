&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> &lt;span style="color:#04a5e5">super&lt;/span>()&lt;span style="color:#04a5e5;font-weight:bold">.&lt;/span>&lt;span style="color:#1e66f5">__init__&lt;/span>() 
